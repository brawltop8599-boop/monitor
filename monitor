@app.route('/api_live_data')
def api_live_data():
    global USER_ACTIVITY, USER_CHANNELS, USER_COUNTRIES, USER_IPS, LIVE_TERMINAL_LOGS, SERVER_VOTES, LIVE_BANS, TEMPORARY_BANS, USER_AGENTS
    cur_t = time.time()

    def _clean_ua_processor(ua_string):
        if not ua_string: return "Неизвестный плеер (Взлом)"
        ua_lower = ua_string.lower()
        if "potplayer" in ua_lower: return "💻 PotPlayer"
        if "tivimate" in ua_lower: return "📺 TiviMate Premium"
        if "navigator" in ua_lower or ("android" in ua_lower and "ott" in ua_lower): return "📱 OTT Navigator"
        if "clatest" in ua_lower or "iptv" in ua_lower: return "📡 IPTV Player"
        if "vlc" in ua_lower: return "💻 VLC Media Player"
        if "televizo" in ua_lower: return "📺 Televizo App"
        if "siptv" in ua_lower: return "🖥️ Smart IPTV (LG/Samsung)"
        if "ssiptv" in ua_lower: return "🖥️ SS IPTV"
        return f"🔌 {ua_string[:20]}..."

    globals()['get_clean_ua'] = _clean_ua_processor

    rows = ""
    sorted_users = sorted(USER_ACTIVITY.items(), key=lambda x: x[1], reverse=True)
    for i, (name, count) in enumerate(sorted_users[:10], 1):
        if count == 0: continue
        user_ips_dict = USER_IPS.get(name, {})
        
        # === ЧИСТЫЙ ЖИВОЙ СТАТУС БЕЗ ЗАПИСИ НА ДИСК ===
        if name in LIVE_BANS:
            ban_status_html = "<span style='font-size: 0.76em; color: #ef4444; font-weight: bold; animation: alarm-pulse 0.8s infinite alternate;'>🚨 ПЕРЕХВАЧЕН ПРЯМО СЕЙЧАС!</span>"
        else:
            ban_status_html = "<span style='font-size: 0.76em; color: #22c55e; font-weight: 500;'>🟢 Нарушений нет</span>"

        last_ts = max(user_ips_dict.values()) if isinstance(user_ips_dict, dict) and user_ips_dict else 0
        status_dot = "<span class='dot dot-green'></span>" if cur_t - last_ts <= 60 else "<span class='dot dot-gray'></span>"
        flag = USER_COUNTRIES.get(name, "🌐")
        medal = "🥇" if i == 1 else "🥈" if i == 2 else "🥉" if i == 3 else "👤"
        masked_name = name[:2] + "*" * (len(name) - 2) if len(name) > 2 else name + "**"
        now_watching = USER_CHANNELS.get(name, "🌐 Сессия active")
        
        raw_ua = USER_AGENTS.get(name, "") if 'USER_AGENTS' in globals() else ""
        clean_viewer_player = _clean_ua_processor(raw_ua)

        rows += f"""<tr>
            <td style='padding: 10px 8px; text-align: left; display: flex; flex-direction: column; gap: 2px;'>
                <div style='display: flex; align-items: center; gap: 4px;'>{status_dot} {medal} {flag} <span style='font-weight: bold;'>{masked_name}</span></div>
                <div style='padding-left: 24px; line-height: 1.1;'>{ban_status_html}</div>
            </td>
            <td style='padding: 10px 8px; text-align: left;'>
                <div style='display: flex; flex-direction: column; gap: 2px;'>
                    <span>{now_watching}</span>
                    <span style='font-size: 0.78em; color: #64748b; font-weight: 500;'>{clean_viewer_player}</span>
                </div>
            </td>
            <td style='padding: 10px 8px; text-align: center;'><span class='count'>{count}</span></td>
        </tr>"""

    terminal_html = "".join([f"<div class='terminal-line'>{log}</div>" for log in LIVE_TERMINAL_LOGS]) if LIVE_TERMINAL_LOGS else "<div style='color:#475569; text-align:center;'>📜 Ожидание событий...</div>"
    total_server_hits = sum(USER_ACTIVITY.values()) if USER_ACTIVITY else 0

    multiroom_bans_html = ""
    for banned_user, info in list(LIVE_BANS.items()):
        remaining = int(TEMPORARY_BANS.get(banned_user, 0) - cur_t)
        if remaining <= 0:
            LIVE_BANS.pop(banned_user, None)
            TEMPORARY_BANS.pop(banned_user, None)
            continue
        m, s = divmod(remaining, 60)
        time_left = f"{m}м {s}с"
        masked_ban_name = banned_user[:3] + "***" if len(banned_user) > 3 else banned_user + "***"
        
        raw_ua = info.get("ua", "") if isinstance(info, dict) else ""
        clean_player = _clean_ua_processor(raw_ua)
        
        multiroom_bans_html += f"""
        <div style="background: rgba(255, 0, 0, 0.12); border: 2px solid #ff3333; padding: 10px 15px; border-radius: 14px; margin-bottom: 8px; box-shadow: 0 0 15px rgba(255, 51, 51, 0.2); width: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 4px;">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div style="color: #ff4444; font-weight: bold; font-size: 0.9em;">🚨 Ник: <span style="color: #fff; font-family: monospace; font-size: 1.1em;">{masked_ban_name}</span> БАН ЗА 2 УСТРОЙСТВА</div>
                <div style="color: #ff9900; font-weight: bold; font-family: monospace; font-size: 0.95em;">⏳ {time_left}</div>
            </div>
            <div style="font-size: 0.82em; color: #94a3b8; border-top: 1px dashed rgba(255,51,51,0.2); padding-top: 4px; text-align: left;">
                📱 Используемый плеер: <span style="color: #f8fafc; font-weight: bold;">{clean_player}</span>
            </div>
        </div>
        """
    total_violators = get_total_violations_count()

    # Логика определения статуса пульса сервера
    # === ОПРЕДЕЛЕНИЕ СТАТУСА ПУЛЬСА СЕРВЕРА ===
    if total_server_hits == 0:
        pulse_status = "<span style='color: #64748b;'>⚪ Сервер спит</span>"
    elif total_server_hits < 100:
        pulse_status = "<span style='color: #22c55e;'>🟢 Все отлично</span>"
    elif total_server_hits < 500:
        pulse_status = "<span style='color: #fbbf24;'>🟡 Пошла жара</span>"
    else:
        pulse_status = "<span style='color: #ef4444;'>🔴 Напряг для барыг</span>"

    # === СТАБИЛЬНЫЙ ОТВЕТ ДЛЯ АВТООБНОВЛЕНИЯ (БЕЗ ОБЛАКА) ===
    return jsonify({
        "iptv_rows": rows,
        "terminal": terminal_html,
        "current_joke": str(get_total_violations_count()),
        "pulse_status": pulse_status,
        "total_hits": total_server_hits,
        "votes": SERVER_VOTES,
        "multiroom_bans_html": multiroom_bans_html,
        "has_active_bans": bool(LIVE_BANS)
    })
