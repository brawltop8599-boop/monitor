        <form method="POST" action="{{ request.full_path }}" style="display:inline;"><input type="hidden" name="action" value="clear_viols"><button type="submit" class="btn" style="background:#666;">Сбросить ⚠️</button></form>
        <form method="POST" action="{{ request.full_path }}" style="display:inline;"><input type="hidden" name="action" value="kick_all"><button type="submit" class="btn" style="background:#d93025; font-weight:bold;">🔥 КИКНУТЬ ВСЕХ</button></form>
		<form method="POST" action="{{ request.full_path }}" style="display:inline;">
