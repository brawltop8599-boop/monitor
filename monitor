		</form>
    </div>
    <div class="card">
        <h2>👥 Пользователи</h2>
        {% for u in users %}
        <div class="user-tag {% if u in vips_list %}vip{% endif %} {% if u in online_users %}online{% endif %}">
            {% if u in online_users %}🟢 {% endif %}{{ u }}
            {% if viols.get(u) %}<span class="violation">⚠️{{ viols.get(u, 0) }}</span>{% endif %}
            <form method="POST" style="display:inline;margin-left:5px;">
