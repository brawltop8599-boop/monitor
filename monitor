@app.route('/test', methods=['GET', 'POST'])
def admin():
    global VIOLATION_HISTORY_DATA, REG_STATUS, TEMPORARY_BANS, WARNINGS, VIOLATIONS, ACTIVE_SESSIONS
    action = None 
    violation_history = [] 
    key = request.args.get('k')
    
    if key != ADMIN_KEY: return "Not Found", 404
    
    users = load_users(); banned = load_banned(); vips = load_vips()
    
    # === ЧИТАЕМ ИСТОРИЮ ИЗ ФАЙЛА ===
    if os.path.exists("ip_registry.txt"):
        try:
            with open("ip_registry.txt", "r", encoding="utf-8") as f:
                lines = f.readlines()
                violation_history = [line.strip() for line in lines[-30:][::-1]]
        except: pass
    
    if request.method == 'POST':
        action = request.form.get('action')
        u = request.form.get('username')
        ip = request.form.get('ip')

        # 1. Системные действия
        if action == 'toggle_reg':
            REG_STATUS["open"] = not REG_STATUS["open"]
        # === ИСПРАВЛЕННАЯ СУПЕР-ОЧИСТКА КЭША И ЛОГОВ (БЕЗ РЕБУТОВ) ===
        if action == 'clear_temp_bans':
            # Начисто стираем списки мультирума и зависшие IP из памяти
            USER_IPS.clear()
            msg = "Все временные баны и кэш IP-адресов успешно стерты из памяти!"
            
        if action == 'clear_history_file':
            # Полностью очищаем бегущую строку хакерского терминала событий
            LIVE_TERMINAL_LOGS.clear()
            msg = "Живой протокол сетевых событий полностью очищен!"
        
        # 2. РУЧНОЙ БАН (Карательная кнопка)
        elif action == 'manual_ip_ban':
            ip_to_ban = request.form.get('target_ip', '').strip()
            if ip_to_ban:
                # Баним в памяти (на 100 лет)
                TEMPORARY_BANS[ip_to_ban] = time.time() + (365 * 24 * 3600 * 100)
                # Пишем в лог
                with open("ip_registry.txt", "a", encoding="utf-8") as f:
                    f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} | АДМИН | IP: {ip_to_ban} | Дал БАН\n")
                # Добавляем в постоянный список banned_ips.txt
                if ip_to_ban not in banned:
                    banned.append(ip_to_ban)
                    save_all_permanent(banned_list=banned)

        # 3. Очистка логов и истории
        elif action == 'clear_violation_file' or action == 'clear_regs':
            TEMPORARY_BANS.clear()
            try:
                with open("ip_registry.txt", "w", encoding="utf-8") as f:
                    f.write("")
                violation_history = []
            except: pass
        
        elif action == 'kick_all':
            ACTIVE_SESSIONS.clear(); VIOLATIONS.clear()
        
        # 4. Управление пользователями
        elif action == 'del' and u != ADMIN_KEY:
            if u in users: users.remove(u)
            if u in vips: vips.remove(u)
            save_all_permanent(users_list=users, vips_list=vips)
        elif action == 'make_vip':
            if u not in vips: vips.append(u); save_all_permanent(vips_list=vips)
        elif action == 'unvip':
            if u in vips: vips.remove(u); save_all_permanent(vips_list=vips)
            
        # 5. Управление бан-листом
        elif action == 'ban_ip' and ip:
            if ip not in banned: banned.append(ip); save_all_permanent(banned_list=banned)
        elif action == 'unban_ip' and ip:
            if ip in banned: banned.remove(ip); save_all_permanent(banned_list=banned)
            
        # ОДИН ОБЩИЙ РЕДИРЕКТ В КОНЦЕ POST-ОБРАБОТКИ
        return redirect(f"/test?k={ADMIN_KEY}")

    # Дальше твой return render_template_string(...)

    # === ЧИТАЕМ ЖУРНАЛ ИЗ ЕДИНОГО ФАЙЛА (ip_registry.txt) ===
    violation_log_html = ""
    if os.path.exists("ip_registry.txt"):
        try:
            with open("ip_registry.txt", "r", encoding="utf-8") as f:
                # Берем последние 30 строк, переворачиваем, чтобы новые были сверху
                lines = f.readlines()[-30:][::-1]
                for line in lines:
                    if "МУЛЬТИРУМ" in line: # Показываем только нарушения
                        # Красим время и ник для красоты
                        violation_log_html += f'<div style="padding:5px; border-bottom:1px dotted #555; font-size:11px; color:#ff4444;">{line.strip()}</div>'
        except:
            violation_log_html = "Ошибка чтения файла"
    
    if not violation_log_html:
        violation_log_html = "Нарушений пока не зафиксировано 🕵️"
        

    load_data(); cur = time.time()
    online_now = [k for k, v in ACTIVE_SESSIONS.items() if cur - v['t'] < 300]
# --- ВСТАВИТЬ СЮДА (ПОСЛЕ online_now) ---
    # === ВОССТАНАВЛИВАЕМ ТРЕУГОЛЬНИКИ ИЗ ФАЙЛА ===
    violations_count = {} 
    if os.path.exists("ip_registry.txt"):
        try:
            with open("ip_registry.txt", "r", encoding="utf-8") as f:
                for line in f:
                    # Ищем любые нарушения (и БАН, и ОДНА СЕТЬ)
                    if "МУЛЬТИРУМ" in line:
                        parts = line.split(" | ")
                        if len(parts) > 1:
                            u_name = parts[1].strip()
                            # Плюсуем треугольник этому нику
                            violations_count[u_name] = violations_count.get(u_name, 0) + 1
        except: pass

    # === ФОРМИРУЕМ ТАБЛИЦУ АКТИВНОСТИ ИЗ ФАЙЛА (НИК И IP) ===
    logs_table_html = ""
    if os.path.exists("ip_registry.txt"):
        try:
            with open("ip_registry.txt", "r", encoding="utf-8") as f:
                # Читаем последние 15 записей, новые сверху
                all_lines = f.readlines()[-15:][::-1]
                for line in all_lines:
                    # Показываем только регистрации (где нет слова МУЛЬТИРУМ)
                    if " | " in line:
                        p = line.split(" | ")
                        u_name = p[1].strip() if len(p) > 1 else "???"
                        # Вытаскиваем IP (убираем приставку IP: если она есть)
                        u_ip = p[2].replace("IP: ", "").strip() if len(p) > 2 else "скрыт"
                        
                        logs_table_html += '<tr>'
                        logs_table_html += f'<td style="padding:8px; border-bottom:1px solid #eee;"><b>{u_name}</b></td>'
                        logs_table_html += f'<td style="padding:8px; border-bottom:1px solid #eee;"><code style="color:#64748b;">{u_ip}</code></td>'
                        logs_table_html += '<td style="padding:8px; border-bottom:1px solid #eee; font-size:11px; color:#64748b;">Событие</td>'
                        logs_table_html += '</tr>'
        except: pass

    # Если в файле пусто, пишем заглушку
    if not logs_table_html:
        logs_table_html = '<tr><td colspan="3" style="text-align:center; padding:15px; color:#94a3b8;">Пока никто не заходил... 📡</td></tr>'

    # Считаем, кто сейчас в бане и сколько им осталось
    banned_temp_list = []
    for k, end_time in TEMPORARY_BANS.items():
        remaining = int(end_time - cur)
        if remaining > 0:
            banned_temp_list.append({'key': k, 'time': remaining})
    if os.path.exists("ip_registry.txt"):
        try:
            with open("ip_registry.txt", "r", encoding="utf-8") as f:
                lines = f.readlines()[-40:] # Берем последние 40 записей
                for line in lines:
                    # Ищем любое упоминание МУЛЬТИРУМА (и БАН, и ОДНА СЕТЬ)
                    if "МУЛЬТИРУМ" in line:
                        parts = line.split(" | ")
                        if len(parts) >= 2:
                            u_key = parts[1].strip()
                            log_time_str = parts[0].strip()
                            try:
                                # Превращаем текст в секунды
                                log_t = time.mktime(time.strptime(log_time_str, "%Y-%m-%d %H:%M:%S"))
                                # Если 5 минут (300 сек) еще не прошли
                                if (time.time() - log_t) < 300:
                                    TEMPORARY_BANS[u_key] = log_t + 300
                            except: continue
        except: pass

# ----------------------------------------
    
    html = '''
