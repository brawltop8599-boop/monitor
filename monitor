			<button type="submit" class="btn" style="background:#333; width: 100%;">🗑 Очистить историю в файле</button>
		</form>
	</div>
<div style="background:#fef2f2; padding:20px; border-radius:15px; border:2px solid #f87171; margin-bottom:20px;">
